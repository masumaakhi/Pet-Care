 //backend/prisma/schema.prisma
 generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  password  String?
  role      Role     @default(user)
  googleId  String?
  phone     String?
  address   String?
  bio       String?
  latitude  Float?
  longitude Float?
  status    String   @default("active")
  createdAt DateTime @default(now())
  pets      Pet[]
  adoptionApplications AdoptionApplication[]
  serviceBookings ServiceBooking[]
  rescuesReported       RescueRequest[]       @relation("Reporter")
  rescuesAssigned       RescueRequest[]       @relation("Volunteer")
  rescueVolunteerAssignments RescueAssignment[] @relation("AssignmentVolunteer")
  volunteerProfile      VolunteerProfile?
  notifications         RescueNotification[]
  donations             Donation[]
  communityPosts        CommunityPost[]    @relation("UserCommunityPosts")
  communityLikes        CommunityLike[]    @relation("UserCommunityLikes")
  communityComments     CommunityComment[] @relation("UserCommunityComments")
}

model Pet {
  id          String   @id @default(uuid())
  name        String
  species     String
  breed       String
  age_months  Int
  gender      String
  weight_kg   Float
  description String?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  status      PetStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  schedules   Schedule[]
  weightLogs  WeightLog[]
  photos      PetPhoto[]
  vaccinations Vaccination[]
  medicalRecords MedicalRecord[]
  prescriptions Prescription[]
  adoptionStatus AdoptionStatus @default(NONE)
  adoptionListing AdoptionPet?
  donationCampaigns   DonationCampaign[]
  donationSponsorSlots DonationSponsorPet[]
}

model PetPhoto {
  id        String   @id @default(uuid())
  url       String
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  ownerId   String
  createdAt DateTime @default(now())
}

model Schedule {
  id              String   @id @default(uuid())
  type            String   // Feeding, Grooming, Exercise, etc.
  title           String?
  scheduled_date  DateTime
  scheduled_time  String
  frequency       String?  // Daily, Weekly, Once
  notes           String?
  petId           String
  pet             Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  ownerId         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model WeightLog {
  id        String   @id @default(uuid())
  weight_kg Float
  date      DateTime @default(now())
  note      String?
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  admin
  user
  owner
  volunteer
  vet
}

enum PetStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum AdoptionStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
  ADOPTED
}

enum RescueStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  PICKED
  VET
  RESCUED
  SHELTER
  CANCELLED
  COMPLETED
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  COMPLETED
}

model Vaccination {
  id              String   @id @default(uuid())
  vaccineName     String
  dose            String
  givenDate       DateTime
  nextDueDate     DateTime?
  vetName         String?
  status          String    // Computed in frontend but stored for quick reference if needed
  reminder        Boolean  @default(true)
  proofUrl        String?
  petId           String
  pet             Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  ownerId         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MedicalRecord {
  id          String   @id @default(uuid())
  date        DateTime
  diagnosis   String
  treatment   String
  vet         String?
  followUp    DateTime?
  cost        Float    @default(0)
  emergency   Boolean  @default(false)
  reportUrl   String?
  petId       String
  pet             Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Prescription {
  id          String   @id @default(uuid())
  date        DateTime
  vet         String?
  fileName    String?
  fileUrl     String?
  medicines   Json?     // Storing as JSON array for flexibility
  notes       String?
  petId       String
  pet             Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdoptionPet {
  id        String   @id @default(uuid())
  name      String
  type      String
  breed     String
  age       String
  gender    String
  size      String?
  image     String?
  tag       String?  @default("Available for Adoption")
  status    AdoptionStatus @default(PENDING)
  
  petId     String?  @unique
  pet       Pet?     @relation(fields: [petId], references: [id])
  
  ownerId   String?
  createdAt DateTime @default(now())

  applications AdoptionApplication[]
}

model RescueRequest {
  id                  String       @id @default(uuid())
  problemType         String
  priority            String
  description         String
  
  // New Location details (made nullable for migration safety)
  incidentAddress     String?
  incidentLat         Float?
  incidentLng         Float?
  locationNote        String?
  
  // Original Location details (kept for backward compatibility)
  address             String?
  latitude            Float?
  longitude           Float?
  
  photoUrl            String?
  status              RescueStatus @default(PENDING)
  
  duplicateFlag       Boolean      @default(false)
  duplicateScore      Float        @default(0.0)
  
  reporterId          String?
  reporter            User?        @relation("Reporter", fields: [reporterId], references: [id])
  
  assignedVolunteerId String?
  assignedVolunteer   User?        @relation("Volunteer", fields: [assignedVolunteerId], references: [id])
  
  assignments         RescueAssignment[]
  duplicateReports    DuplicateRescueReport[] @relation("MainRequest")
  asDuplicateIn       DuplicateRescueReport[] @relation("DuplicateRequest")
  
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model AdoptionApplication {
  id              String   @id @default(uuid())
  adoptionPetId   String
  adoptionPet     AdoptionPet @relation(fields: [adoptionPetId], references: [id])
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  fullName        String
  email           String
  phone           String
  livingSituation String
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
}

model ServiceBooking {
  id            String   @id @default(uuid())
  providerName  String
  type          String   // vet, groomer, consultation
  serviceTitle  String
  date          String
  time          String
  status        String   @default("upcoming") // upcoming, completed, cancelled
  petName       String
  petType       String?
  amount        String?
  providerNotes String?
  cancelReason  String?
  prescription  String?
  meetingLink   String?
  summary       String?
  reviewed      Boolean  @default(false)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model VolunteerProfile {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id])
  availability  Boolean   @default(true)
  radiusKM      Float     @default(10.0)
  lastLat       Float?
  lastLng       Float?
  lastActive    DateTime? @default(now())
  
  movementHistory VolunteerLiveLocation[]
}

model VolunteerLiveLocation {
  id          String   @id @default(uuid())
  volunteerId String
  volunteer   VolunteerProfile @relation(fields: [volunteerId], references: [id])
  latitude    Float
  longitude   Float
  timestamp   DateTime @default(now())
}

model RescueAssignment {
  id            String           @id @default(uuid())
  rescueId      String
  rescue        RescueRequest    @relation(fields: [rescueId], references: [id])
  volunteerId   String
  volunteer     User             @relation("AssignmentVolunteer", fields: [volunteerId], references: [id])
  status        AssignmentStatus @default(PENDING)
  assignedAt    DateTime         @default(now())
  respondedAt   DateTime?
  notes         String?
}

model DuplicateRescueReport {
  id                  String        @id @default(uuid())
  mainRequestId       String
  mainRequest         RescueRequest @relation("MainRequest", fields: [mainRequestId], references: [id])
  duplicateRequestId  String
  duplicateRequest    RescueRequest @relation("DuplicateRequest", fields: [duplicateRequestId], references: [id])
  confidenceScore     Float
  status              String        @default("PENDING") // PENDING, CONFIRMED, REJECTED
  createdAt           DateTime      @default(now())
}

model RescueNotification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   // SYSTEM, ASSIGNMENT, STATUS_UPDATE
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum DonationCampaignStatus {
  active
  completed
  paused
}

enum DonationPaymentStatus {
  pending
  paid
  failed
}

model DonationCampaign {
  id          String                 @id @default(uuid())
  title       String
  description String
  image       String
  type        String
  goalAmount  Float
  status      DonationCampaignStatus @default(active)
  petId       String?
  pet         Pet?                   @relation(fields: [petId], references: [id])
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  donations   Donation[]
}

model DonationSponsorPet {
  id                       String   @id @default(uuid())
  name                     String
  breed                    String
  age                      String
  image                    String
  story                    String
  monthlySponsorshipAmount Float
  status                   String   @default("needs_sponsor")
  petId                    String?
  pet                      Pet?     @relation(fields: [petId], references: [id])
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  donations                Donation[]
}

model Donation {
  id                 String                @id @default(uuid())
  userId             String?
  user               User?                 @relation(fields: [userId], references: [id])
  donorName          String
  donorEmail         String
  amount             Float
  type               String
  frequency          String                @default("one_time")
  status             DonationPaymentStatus @default(paid)
  message            String?
  receiptUrl         String?
  campaignId         String?
  campaign           DonationCampaign?     @relation(fields: [campaignId], references: [id])
  sponsorPetId       String?
  sponsorPet         DonationSponsorPet?   @relation(fields: [sponsorPetId], references: [id])
  designationLabel   String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
}

model CommunityPost {
  id          String   @id @default(uuid())
  authorId    String
  author      User     @relation("UserCommunityPosts", fields: [authorId], references: [id])
  category    String
  type        String   @default("update")
  content     String
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  likes       CommunityLike[]
  comments    CommunityComment[]
}

model CommunityLike {
  id        String   @id @default(uuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("UserCommunityLikes", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model CommunityComment {
  id        String   @id @default(uuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("UserCommunityComments", fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
