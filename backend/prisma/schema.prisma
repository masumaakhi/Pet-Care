generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  password  String?
  role      Role     @default(user)
  googleId  String?
  createdAt DateTime @default(now())
  pets      Pet[]
  adoptionApplications AdoptionApplication[]
  serviceBookings ServiceBooking[]
}

model Pet {
  id          String   @id @default(uuid())
  name        String
  species     String
  breed       String
  age_months  Int
  gender      String
  weight_kg   Float
  description String?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  status      PetStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  schedules   Schedule[]
  weightLogs  WeightLog[]
  photos      PetPhoto[]
  vaccinations Vaccination[]
  medicalRecords MedicalRecord[]
  prescriptions Prescription[]
}

model PetPhoto {
  id        String   @id @default(uuid())
  url       String
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  ownerId   String
  createdAt DateTime @default(now())
}

model Schedule {
  id              String   @id @default(uuid())
  type            String   // Feeding, Grooming, Exercise, etc.
  title           String?
  scheduled_date  DateTime
  scheduled_time  String
  frequency       String?  // Daily, Weekly, Once
  notes           String?
  petId           String
  pet             Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  ownerId         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model WeightLog {
  id        String   @id @default(uuid())
  weight_kg Float
  date      DateTime @default(now())
  note      String?
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  admin
  user
  owner
  volunteer
  vet
}

enum PetStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

model Vaccination {
  id              String   @id @default(uuid())
  vaccineName     String
  dose            String
  givenDate       DateTime
  nextDueDate     DateTime?
  vetName         String?
  status          String    // Computed in frontend but stored for quick reference if needed
  reminder        Boolean  @default(true)
  proofUrl        String?
  petId           String
  pet             Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  ownerId         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MedicalRecord {
  id          String   @id @default(uuid())
  date        DateTime
  diagnosis   String
  treatment   String
  vet         String?
  followUp    DateTime?
  cost        Float    @default(0)
  emergency   Boolean  @default(false)
  reportUrl   String?
  petId       String
  pet             Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Prescription {
  id          String   @id @default(uuid())
  date        DateTime
  vet         String?
  fileName    String?
  fileUrl     String?
  medicines   Json?     // Storing as JSON array for flexibility
  notes       String?
  petId       String
  pet             Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdoptionPet {
  id        String   @id @default(uuid())
  name      String
  type      String
  breed     String
  age       String
  gender    String
  size      String?
  image     String?
  tag       String?  @default("Available for Adoption")
  createdAt DateTime @default(now())

  applications AdoptionApplication[]
}

model AdoptionApplication {
  id              String   @id @default(uuid())
  adoptionPetId   String
  adoptionPet     AdoptionPet @relation(fields: [adoptionPetId], references: [id])
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  fullName        String
  email           String
  phone           String
  livingSituation String
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
}

model ServiceBooking {
  id            String   @id @default(uuid())
  providerName  String
  type          String   // vet, groomer, consultation
  serviceTitle  String
  date          String
  time          String
  status        String   @default("upcoming") // upcoming, completed, cancelled
  petName       String
  petType       String?
  amount        String?
  providerNotes String?
  cancelReason  String?
  prescription  String?
  meetingLink   String?
  summary       String?
  reviewed      Boolean  @default(false)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
