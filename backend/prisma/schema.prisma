generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  password  String?
  role      Role     @default(user)
  googleId  String?
  createdAt DateTime @default(now())
}

enum Role {
  admin
  user
  owner
  volunteer
  vet
}